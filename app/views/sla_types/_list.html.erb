<%= form_tag({}, data: {cm_url: context_menu_sla_types_path}) do %>
  <%= hidden_field_tag 'back_url', url_for(params: request.query_parameters), id: nil %>
  <div class="autoscroll">
    <table class="list odd-even entities sla_types">
      <thead>
        <tr>
          <th class="checkbox hide-when-print">
            <%= check_box_tag 'check_all', '', false, class: 'toggle-selection',
            title: "#{l(:button_check_all)}/#{l(:button_uncheck_all)}" -%>
          </th>
          <% @query.inline_columns.each do |column| %>
            <%= column_header(@query, column) -%>
          <% end %>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% entities.each do |entity| %>
          <tr id="entity_id_<%= entity.id %>" class="entity <%= cycle('odd', 'even') %> hascontextmenu">
            <td class="checkbox hide-when-print"><%= check_box_tag('ids[]', entity.id, false, id: nil) %></td>
            <% @query.inline_columns.each do |column| %>
              <%= content_tag('td', column_content(column, entity), class: column.css_classes) %>
            <% end %>
            <td class="buttons">
              <%= reorder_handle(entity) if @can_reorder -%>
              <%= if entity.visible?
                    link_to l(:button_show), sla_type_path(entity),
                            title: l(:button_show), class: 'icon-only icon-magnifier'
                  end -%>
              <%= if entity.editable?
                    link_to l(:button_edit), edit_sla_type_path(entity),
                            title: l(:button_edit), class: 'icon-only icon-edit'
                  end -%>
              <%= if entity.deletable?
                    link_to l(:button_delete), sla_type_path(entity),
                            data: {confirm: l(:text_are_you_sure)}, method: :delete,
                            title: l(:button_delete), class: 'icon-only icon-del'
                  end -%>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
<%= context_menu %>
<% if @can_reorder -%>
  <%= javascript_tag do %>
    $(function() { $("table.sla_types tbody").positionedItems(); });
  <% end %>
<% end -%>
